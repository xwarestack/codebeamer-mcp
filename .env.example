# Codebeamer API URL including the /cb/api context path (the server appends /v3)
CB_URL=https://your-instance.example.com/cb/api

# Credentials for HTTP Basic Auth
CB_USERNAME=your_username
CB_PASSWORD=your_password

# What the MCP client may change: read (default), write (items, comments, links, ...)
# or admin (also tracker configuration, permissions, deployment via api_call)
# CB_MODE=read

# Request timeout in milliseconds
# CB_TIMEOUT_MS=30000

# OpenAPI spec for the api_* tools (file path or URL), e.g. the swagger.json downloaded from
# your instance's Swagger page; defaults to the bundled docs/codebeamer-openapi-v3.json
# CB_OPENAPI_SPEC=/path/to/swagger.json

# Set to "true" to allow connections to servers with unverified/self-signed certificates
# CB_UNSAFE_SSL=true
