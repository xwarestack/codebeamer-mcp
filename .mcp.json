{
  "mcpServers": {
    "codebeamer": {
      "type": "stdio",
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "CB_URL": "${CB_URL:-}",
        "CB_USERNAME": "${CB_USERNAME:-}",
        "CB_PASSWORD": "${CB_PASSWORD:-}",
        "CB_MODE": "${CB_MODE:-read}"
      }
    }
  }
}
